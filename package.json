{
	"name": "omp-nous-portal-provider",
	"version": "0.1.1",
	"description": "Nous Research Portal provider for oh-my-pi, with Portal OAuth and direct API-key authentication.",
	"type": "module",
	"engines": {
		"node": ">=22",
		"bun": ">=1.3.14"
	},
	"bin": {
		"omp-nous-broker": "./broker.ts"
	},
	"scripts": {
		"test": "node --test tests/*.test.mjs",
		"test:compat": "node --test tests/compat/*.test.mjs",
		"test:broker": "bun test tests/broker",
		"typecheck": "tsc --noEmit",
		"check": "npm run typecheck && npm test && npm run test:broker"
	},
	"keywords": [
		"omp",
		"oh-my-pi",
		"pi-package",
		"pi-extension",
		"pi-provider",
		"pi-coding-agent",
		"ai-provider",
		"llm-provider",
		"nous",
		"hermes"
	],
	"license": "MIT",
	"homepage": "https://github.com/TerrifiedBug/omp-nous-portal-provider#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TerrifiedBug/omp-nous-portal-provider.git"
	},
	"bugs": {
		"url": "https://github.com/TerrifiedBug/omp-nous-portal-provider/issues"
	},
	"files": [
		"broker.ts",
		"extensions",
		"docs",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./extensions/nous-portal/index.ts"
		]
	},
	"peerDependencies": {
		"@oh-my-pi/pi-ai": "^18.4.2",
		"@oh-my-pi/pi-coding-agent": "^18.4.2",
		"@oh-my-pi/pi-utils": "^18.4.2"
	},
	"devDependencies": {
		"@oh-my-pi/pi-ai": "18.4.2",
		"@oh-my-pi/pi-coding-agent": "18.4.2",
		"@oh-my-pi/pi-utils": "18.4.2",
		"@types/bun": "^1.3.14",
		"@types/node": "^24.10.0",
		"typescript": "^5.9.3"
	}
}
